---
import BaseLayout from "@layouts/BaseLayout.astro";

if (!import.meta.env.DEV) {
  return Astro.redirect("/");
}
---

<BaseLayout title="Author">
  <section class="author">
    <h1>Author</h1>
    <p class="meta">Create a trip, then write one day at a time. Dev only.</p>

    <form id="create-form" class="author-form">
      <h2>New trip</h2>
      <label>
        Title
        <input name="title" required placeholder="Olympic Peninsula" />
      </label>
      <label>
        Slug
        <input name="slug" placeholder="olympic-peninsula" />
      </label>
      <div class="row">
        <label>
          Start date
          <input name="date" type="date" required />
        </label>
        <label>
          End date
          <input name="endDate" type="date" />
        </label>
      </div>
      <label>
        Location
        <input name="location" placeholder="Washington" />
      </label>
      <label>
        Summary
        <input name="summary" placeholder="A week of rainforest and coast." />
      </label>
      <button type="submit">Create trip</button>
      <p id="create-error" class="error" hidden></p>
    </form>

    <h2>Trips</h2>
    <ul id="trip-list" class="author-list"></ul>
  </section>
</BaseLayout>

<style>
  .author {
    max-width: 36rem;
  }
  .author h1,
  .author h2 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }
  .author-form {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 2.5rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .author-form label {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }
  .author-form input {
    font: inherit;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line);
    background: #fff;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  button {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    width: fit-content;
  }
  .error {
    color: #8a2f2f;
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }
  .author-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .author-list a {
    font-family: var(--font-ui);
  }
</style>

<script>
  function slugify(title) {
    return title
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 80);
  }

  const form = document.getElementById("create-form");
  const titleInput = form.querySelector('[name="title"]');
  const slugInput = form.querySelector('[name="slug"]');
  const err = document.getElementById("create-error");
  const list = document.getElementById("trip-list");

  titleInput.addEventListener("input", () => {
    if (!slugInput.dataset.touched) slugInput.value = slugify(titleInput.value);
  });
  slugInput.addEventListener("input", () => {
    slugInput.dataset.touched = "1";
  });

  async function loadTrips() {
    const res = await fetch("/api/author/trips");
    const data = await res.json();
    list.innerHTML = "";
    for (const trip of data.trips ?? []) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `/author/${trip.slug}`;
      a.textContent = `${trip.title} (${trip.date}${trip.endDate ? ` – ${trip.endDate}` : ""})`;
      li.appendChild(a);
      list.appendChild(li);
    }
    if (!data.trips?.length) {
      list.innerHTML = "<li class='meta'>No trips yet.</li>";
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    err.hidden = true;
    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    if (!payload.slug) payload.slug = slugify(String(payload.title));
    if (!payload.endDate) delete payload.endDate;
    const res = await fetch("/api/author/trips", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (!res.ok) {
      err.textContent = data.error || "Could not create trip";
      err.hidden = false;
      return;
    }
    if (data.warning) {
      err.textContent = data.warning;
      err.hidden = false;
    }
    window.location.href = `/author/${data.trip.slug}?date=${data.trip.date}`;
  });

  loadTrips();
</script>
