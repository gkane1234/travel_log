---
import BaseLayout from "@layouts/BaseLayout.astro";
import { listTripSlugs } from "../../lib/author";

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const slugs = await listTripSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

if (!import.meta.env.DEV) {
  return Astro.redirect("/");
}

const { slug } = Astro.params;
---

<BaseLayout title={`Author · ${slug}`}>
  <section class="editor" data-slug={slug}>
    <p class="meta">
      <a href="/author">← Author</a>
      ·
      <a id="view-link" href={`/trips/${slug}/`}>View trip</a>
    </p>
    <h1 id="trip-title">Loading…</h1>
    <p id="trip-meta" class="meta"></p>

    <div class="day-nav">
      <button type="button" id="prev-day">Previous day</button>
      <label class="jump">
        Day
        <input type="date" id="jump-date" />
      </label>
      <button type="button" id="next-day">Next day</button>
      <button type="button" id="save-day" class="primary">Save day</button>
    </div>

    <p id="status" class="meta" aria-live="polite"></p>

    <div id="dropzone" class="dropzone">
      <textarea
        id="day-body"
        rows="18"
        placeholder="Write this day's notes. Drop photos, videos, or GPX here (or use the buttons)."
      ></textarea>
      <div class="drop-hint">Drop .heic / .jpg / .mov / .gpx / .zip onto the text</div>
    </div>

    <div class="upload-row">
      <label class="file-btn">
        Add photo / video
        <input id="media-input" type="file" accept=".heic,.heif,.jpg,.jpeg,.png,.webp,.gif,.mov,.mp4,.m4v,.webm" hidden />
      </label>
      <label class="file-btn">
        Add GPX
        <input id="gpx-input" type="file" accept=".gpx,.zip" hidden />
      </label>
    </div>
  </section>
</BaseLayout>

<style>
  .editor {
    max-width: 48rem;
  }
  .editor h1 {
    font-family: var(--font-display);
    margin: 0.4rem 0;
    letter-spacing: -0.02em;
  }
  .day-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: end;
    margin: 1.25rem 0 0.75rem;
  }
  .day-nav button,
  .file-btn {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    cursor: pointer;
  }
  .day-nav button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .day-nav button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .jump {
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }
  .jump input {
    font: inherit;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--line);
  }
  .dropzone {
    position: relative;
  }
  .dropzone.dragover textarea {
    outline: 2px solid var(--accent);
    background: #fff;
  }
  textarea {
    width: 100%;
    font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
    font-size: 0.92rem;
    line-height: 1.5;
    padding: 0.9rem;
    border: 1px solid var(--line);
    background: #fff;
    resize: vertical;
  }
  .drop-hint {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.4rem;
  }
  .upload-row {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }
  .file-btn {
    display: inline-block;
  }
</style>

<script>
  const root = document.querySelector(".editor");
  const slug = root.dataset.slug;
  const titleEl = document.getElementById("trip-title");
  const metaEl = document.getElementById("trip-meta");
  const bodyEl = document.getElementById("day-body");
  const jumpEl = document.getElementById("jump-date");
  const prevBtn = document.getElementById("prev-day");
  const nextBtn = document.getElementById("next-day");
  const saveBtn = document.getElementById("save-day");
  const statusEl = document.getElementById("status");
  const dropzone = document.getElementById("dropzone");
  const mediaInput = document.getElementById("media-input");
  const gpxInput = document.getElementById("gpx-input");

  let currentDate = new URLSearchParams(location.search).get("date");
  let trip = null;
  let dirty = false;

  function setStatus(msg) {
    statusEl.textContent = msg;
  }

  function insertAtCursor(text) {
    const start = bodyEl.selectionStart ?? bodyEl.value.length;
    const end = bodyEl.selectionEnd ?? start;
    const before = bodyEl.value.slice(0, start);
    const after = bodyEl.value.slice(end);
    const needsPadBefore = before.length && !before.endsWith("\n") ? "\n\n" : before.endsWith("\n") ? "\n" : "";
    const needsPadAfter = after.length && !after.startsWith("\n") ? "\n\n" : "\n";
    const snippet = `${needsPadBefore}${text}${needsPadAfter}`;
    bodyEl.value = before + snippet + after;
    const pos = (before + snippet).length;
    bodyEl.focus();
    bodyEl.setSelectionRange(pos, pos);
    dirty = true;
  }

  async function saveDay() {
    if (!currentDate) return;
    setStatus("Saving…");
    const res = await fetch(`/api/author/trips/${slug}/days/${currentDate}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ body: bodyEl.value }),
    });
    const data = await res.json();
    if (!res.ok) {
      setStatus(data.error || "Save failed");
      return;
    }
    dirty = false;
    setStatus(
      data.warning ? `Saved ${currentDate}. ${data.warning}` : `Saved ${currentDate}`,
    );
  }

  async function loadDay(date, { pushUrl = true } = {}) {
    if (dirty) {
      const ok = confirm("Save current day before switching?");
      if (ok) await saveDay();
      else dirty = false;
    }
    setStatus("Loading…");
    const res = await fetch(
      `/api/author/trips/${slug}/days/${date}?ensure=1`,
    );
    const data = await res.json();
    if (!res.ok) {
      setStatus(data.error || "Could not load day");
      return;
    }
    trip = data.trip;
    currentDate = data.date;
    titleEl.textContent = trip.title;
    metaEl.textContent = [
      trip.location,
      trip.endDate ? `${trip.date} – ${trip.endDate}` : trip.date,
      "draft",
    ]
      .filter(Boolean)
      .join(" · ");
    bodyEl.value = data.body ?? "";
    jumpEl.value = currentDate;
    jumpEl.min = trip.date;
    if (trip.endDate) jumpEl.max = trip.endDate;
    else jumpEl.removeAttribute("max");
    prevBtn.disabled = !data.canPrev;
    nextBtn.disabled = !data.canNext;
    prevBtn.dataset.date = data.prev || "";
    nextBtn.dataset.date = data.next || "";
    dirty = false;
    if (pushUrl) {
      const url = new URL(location.href);
      url.searchParams.set("date", currentDate);
      history.replaceState({}, "", url);
    }
    setStatus(`Editing ${currentDate}`);
  }

  async function init() {
    const metaRes = await fetch(`/api/author/trips/${slug}`);
    const meta = await metaRes.json();
    if (!metaRes.ok) {
      titleEl.textContent = "Trip not found";
      setStatus(meta.error || "");
      return;
    }
    trip = meta.trip;
    const start = currentDate || trip.date;
    await loadDay(start);
  }

  prevBtn.addEventListener("click", () => {
    if (prevBtn.dataset.date) loadDay(prevBtn.dataset.date);
  });
  nextBtn.addEventListener("click", () => {
    if (nextBtn.dataset.date) loadDay(nextBtn.dataset.date);
  });
  jumpEl.addEventListener("change", () => {
    if (jumpEl.value) loadDay(jumpEl.value);
  });
  saveBtn.addEventListener("click", () => saveDay());
  bodyEl.addEventListener("input", () => {
    dirty = true;
  });

  async function uploadMedia(file) {
    setStatus(`Uploading ${file.name}…`);
    const fd = new FormData();
    fd.append("file", file);
    const res = await fetch(`/api/author/trips/${slug}/media`, {
      method: "POST",
      body: fd,
    });
    const data = await res.json();
    if (!res.ok) {
      setStatus(data.error || "Upload failed");
      return;
    }
    insertAtCursor(data.markdown);
    await saveDay();
    setStatus(`Inserted ${data.filename}`);
  }

  async function uploadGpx(file) {
    setStatus(`Uploading ${file.name}…`);
    const fd = new FormData();
    fd.append("file", file);
    const res = await fetch(`/api/author/trips/${slug}/gpx`, {
      method: "POST",
      body: fd,
    });
    const data = await res.json();
    if (!res.ok) {
      setStatus(data.error || "Upload failed");
      return;
    }
    insertAtCursor(data.markdown);
    await saveDay();
    setStatus(`Inserted route ${data.filename}`);
  }

  async function handleFiles(files) {
    for (const file of files) {
      const name = file.name.toLowerCase();
      if (name.endsWith(".gpx") || name.endsWith(".zip")) await uploadGpx(file);
      else await uploadMedia(file);
    }
  }

  mediaInput.addEventListener("change", () => {
    if (mediaInput.files?.length) handleFiles(mediaInput.files);
    mediaInput.value = "";
  });
  gpxInput.addEventListener("change", () => {
    if (gpxInput.files?.length) handleFiles(gpxInput.files);
    gpxInput.value = "";
  });

  ["dragenter", "dragover"].forEach((evt) => {
    dropzone.addEventListener(evt, (e) => {
      e.preventDefault();
      dropzone.classList.add("dragover");
    });
  });
  ["dragleave", "drop"].forEach((evt) => {
    dropzone.addEventListener(evt, (e) => {
      e.preventDefault();
      dropzone.classList.remove("dragover");
    });
  });
  dropzone.addEventListener("drop", (e) => {
    const files = e.dataTransfer?.files;
    if (files?.length) handleFiles(files);
  });

  window.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "s") {
      e.preventDefault();
      saveDay();
    }
  });

  init();
</script>
