---
import BaseLayout from "@layouts/BaseLayout.astro";

const error = Astro.url.searchParams.get("error");
---

<BaseLayout title="Log in">
  <section class="author">
    <h1>Author</h1>
    <p class="meta">Sign in to edit trips. The public site stays open without a login.</p>
    {
      error === "config" && (
        <p class="error">
          Author mode is not configured. Set AUTHOR_USERNAME, AUTHOR_PASSWORD, and AUTHOR_SECRET.
        </p>
      )
    }
    {error === "1" && <p class="error">Wrong username or password.</p>}
    <form class="author-form" method="post" action="/api/author/login">
      <label>
        Username
        <input name="username" autocomplete="username" required />
      </label>
      <label>
        Password
        <input name="password" type="password" autocomplete="current-password" required />
      </label>
      <button type="submit">Log in</button>
    </form>
  </section>
</BaseLayout>

<style>
  .author {
    max-width: 36rem;
  }
  .author h1 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }
  .author-form {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0;
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .author-form label {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }
  .author-form input {
    font: inherit;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line);
    background: #fff;
  }
  button {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    width: fit-content;
  }
  .error {
    color: #8a2f2f;
    font-family: var(--font-ui);
  }
</style>
