---
import BaseLayout from "@layouts/BaseLayout.astro";
import { site } from "@lib/site";
import { listPublicTrips } from "@lib/render-markdown";
import { formatTripDates, parseDateString } from "@lib/trips";

export const prerender = false;

const trips = await listPublicTrips();
---

<BaseLayout>
  <section class="prose">
    <h1>{site.name}</h1>
    <p class="meta">{site.description}</p>
  </section>

  {
    trips.length === 0 ? (
      <p class="meta" style="margin-top: 2rem;">No trips yet.</p>
    ) : (
      <ul class="trip-list">
        {trips.map((trip) => (
          <li>
            <a class="trip-card" href={`/trips/${trip.slug}/`}>
              <div class="trip-card__cover">
                {trip.cover ? <img src={trip.cover} alt="" loading="lazy" /> : null}
              </div>
              <div>
                <h2>{trip.title}</h2>
                <p class="meta">
                  {[
                    trip.location,
                    formatTripDates(
                      parseDateString(trip.date),
                      trip.endDate ? parseDateString(trip.endDate) : undefined,
                    ),
                  ]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
                {trip.summary ? <p>{trip.summary}</p> : null}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
