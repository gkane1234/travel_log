---
interface Props {
  src: string;
  title?: string;
}

const { src, title } = Astro.props;
const filename = src.split("/").pop() ?? src;
---

<figure class="trip-map">
  <div class="trip-map__canvas" aria-hidden="true">
    <span class="trip-map__mark">map</span>
  </div>
  <figcaption>
    <strong>{title ?? "Route"}</strong>
    <span>{filename}</span>
    <em>Interactive map coming later</em>
  </figcaption>
</figure>

<style>
  .trip-map {
    margin: 1.75rem 0;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .trip-map__canvas {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    background:
      linear-gradient(135deg, rgba(46, 74, 62, 0.12), transparent 55%),
      repeating-linear-gradient(
        -12deg,
        transparent,
        transparent 11px,
        rgba(46, 74, 62, 0.06) 11px,
        rgba(46, 74, 62, 0.06) 12px
      );
  }
  .trip-map__mark {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  figcaption {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1rem 1rem;
    border-top: 1px solid var(--line);
  }
  figcaption strong {
    font-family: var(--font-display);
    font-weight: 600;
  }
  figcaption span,
  figcaption em {
    font-size: 0.9rem;
    color: var(--muted);
    font-style: normal;
  }
  figcaption em {
    font-style: italic;
  }
</style>
