---
import BaseLayout from "@layouts/BaseLayout.astro";
import { listPublicTrips, loadPublicTrip, publicAsset } from "@lib/render-markdown";
import { formatTripDates, parseDateString } from "@lib/trips";

export async function getStaticPaths() {
  const trips = await listPublicTrips();
  return trips.map((trip) => ({ params: { slug: trip.slug } }));
}

const slug = Astro.params.slug ?? "";
const base = import.meta.env.BASE_URL;
const page = await loadPublicTrip(slug, base);
if (!page) throw new Error(`Missing trip ${slug}`);

const { meta, introHtml, days } = page;
---

<BaseLayout title={meta.title} description={meta.summary}>
  <article class="prose">
    <p class="meta"><a href={base}>← Trips</a></p>
    <h1>{meta.title}</h1>
    {meta.cover ? <img class="trip-cover" src={publicAsset(meta.cover, base)} alt="" /> : null}
    <p class="meta">
      {
        [
          meta.location,
          formatTripDates(
            parseDateString(meta.date),
            meta.endDate ? parseDateString(meta.endDate) : undefined,
          ),
        ]
          .filter(Boolean)
          .join(" · ")
      }
    </p>
    <div set:html={introHtml} />
    {
      days.map((day) => (
        <section class="day-block">
          <h2>{day.date}</h2>
          <div set:html={day.html} />
        </section>
      ))
    }
  </article>
</BaseLayout>
