---
import BaseLayout from "@layouts/BaseLayout.astro";
import { loadPublicTrip } from "@lib/render-markdown";
import { formatTripDates, parseDateString } from "@lib/trips";

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/");

const page = await loadPublicTrip(slug);
if (!page) return new Response("Not found", { status: 404 });

const { meta, introHtml, days } = page;
---

<BaseLayout title={meta.title} description={meta.summary}>
  <article class="prose">
    <p class="meta"><a href="/">← Trips</a></p>
    <h1>{meta.title}</h1>
    <p class="meta">
      {
        [
          meta.location,
          formatTripDates(
            parseDateString(meta.date),
            meta.endDate ? parseDateString(meta.endDate) : undefined,
          ),
        ]
          .filter(Boolean)
          .join(" · ")
      }
    </p>
    <div set:html={introHtml} />
    {
      days.map((day) => (
        <section class="day-block">
          <h2>{day.date}</h2>
          <div set:html={day.html} />
        </section>
      ))
    }
  </article>
</BaseLayout>
