---
interface Props {
  slug?: string;
}

const { slug = "" } = Astro.props;
---

<section class="author" data-author-root data-slug={slug}>
  <div id="screen-settings">
    <h1>Author</h1>
    <p class="meta">
      Saving a day writes the note to the travel log. Photos and videos go to storage. Nothing from a trip is added to the git repo.
    </p>
    <form id="settings-form" class="author-form">
      <h2>GitHub</h2>
      <label>
        Personal access token
        <input name="token" type="password" autocomplete="off" />
      </label>
      <div class="row">
        <label>
          Owner
          <input name="owner" required placeholder="your-name" />
        </label>
        <label>
          Repository
          <input name="repo" required placeholder="travel_log" />
        </label>
      </div>
      <label>
        Branch
        <input name="branch" value="master" />
      </label>
      <h2>Photos and videos</h2>
      <p class="meta">Uploaded to the bucket first. They are not added to the git commit.</p>
      <label>
        Media upload URL
        <input name="mediaWorkerUrl" placeholder="https://gabriel-kane.com" />
      </label>
      <label>
        Upload token
        <input name="uploadToken" type="password" autocomplete="off" />
      </label>
      <p class="meta">
        Leave the upload token blank to use the GitHub token. Bucket keys stay on the Cloudflare Worker.
      </p>
      <label>
        Published author URL
        <input name="pagesUrl" placeholder="https://you.github.io/travel_log/author/" />
      </label>
      <button type="submit">Save in this browser</button>
      <button type="button" id="forget-token" class="linkish">Forget token</button>
      <p id="settings-error" class="error" hidden></p>
    </form>
    <label class="home-url">
      Home Screen and shortcut URL
      <input id="home-screen-url" readonly />
    </label>
    <p class="meta">
      iPhone: open that URL in Safari, then Share → Add to Home Screen. Mac: run
      <code>scripts/open-author.command</code> with that URL and keep it in the Dock. Windows: run
      <code>scripts/author-shortcut.ps1 -Url</code> with that URL.
    </p>
  </div>

  <div id="screen-list" hidden>
    <h1>Author</h1>
    <p id="list-status" class="meta">Saving a day updates the travel log. Photos and videos go to storage.</p>
    <p>
      <button type="button" class="linkish" data-open-settings>GitHub settings</button>
    </p>

    <form id="create-form" class="author-form">
      <h2>New trip</h2>
      <div class="kind-choice">
        <span>Kind</span>
        <label><input type="radio" name="kind" value="trip" checked /> Trip</label>
        <label><input type="radio" name="kind" value="outing" /> Day trip</label>
      </div>
      <label>
        Title
        <input name="title" required placeholder="Olympic Peninsula" />
      </label>
      <label>
        Slug
        <input name="slug" placeholder="olympic-peninsula" />
      </label>
      <div class="row">
        <label>
          Start date
          <input name="date" type="date" required />
        </label>
        <label>
          End date
          <input name="endDate" type="date" />
        </label>
      </div>
      <p class="meta">A day trip only needs a start date. Leave the end date blank, or set it to the same day.</p>
      <label>
        Location
        <input name="location" placeholder="Washington" />
      </label>
      <label>
        Summary
        <input name="summary" placeholder="A week of rainforest and coast." />
      </label>
      <div id="create-drop" class="file-drop">
        <p>Drop photos and videos here</p>
        <label class="file-btn">
          Choose photos and videos
          <input id="create-media" type="file" multiple accept=".heic,.heif,.jpg,.jpeg,.png,.webp,.gif,.mov,.mp4,.m4v,.webm" />
        </label>
      </div>
      <p class="meta">Optional. Add many at once. After the trip is created, you place each one in a day.</p>
      <button type="submit">Create trip</button>
      <p id="create-error" class="error" hidden></p>
    </form>

    <h2>Trips</h2>
    <ul id="trip-list" class="author-list"></ul>
  </div>

  <div id="screen-editor" class="editor" hidden>
    <p class="meta">
      <button type="button" id="back-to-list" class="linkish">← Author</button>
      ·
      <a id="view-link" href="/">View trip</a>
      ·
      <button type="button" class="linkish" data-open-settings>GitHub settings</button>
    </p>
    <h1 id="trip-title">Loading…</h1>
    <p id="trip-meta" class="meta"></p>
    <form id="details-form" class="author-form">
      <h2>Trip details</h2>
      <label>
        Name
        <input id="details-title" name="title" required />
      </label>
      <label>
        Location
        <input id="details-location" name="location" />
      </label>
      <div class="row">
        <label>
          Start date
          <input id="details-date" name="date" type="date" required />
        </label>
        <label>
          End date
          <input id="details-end" name="endDate" type="date" />
        </label>
      </div>
      <p class="meta">A day trip can be a single date. Changing the name keeps the same address.</p>
      <button type="submit">Save details</button>
      <p id="details-error" class="error" hidden></p>
    </form>
    <p>
      <button type="button" class="linkish" data-open-settings>GitHub settings</button>
    </p>
    <div class="cover-picker">
      <p class="meta">Thumbnail</p>
      <p id="cover-summary" class="cover-summary meta">First photo in the trip</p>
      <button type="button" id="cover-toggle" aria-expanded="false">Change thumbnail</button>
      <div id="cover-panel" hidden>
        <div id="cover-choices" class="cover-grid"></div>
        <button type="button" id="save-cover">Save thumbnail</button>
        <button type="button" id="cover-close" class="linkish">Close</button>
      </div>
    </div>
    <div id="add-photos-panel">
      <div id="add-drop" class="file-drop">
        <p>Drop photos and videos here</p>
        <label class="file-btn">
          Choose photos and videos
          <input id="media-input" type="file" multiple accept=".heic,.heif,.jpg,.jpeg,.png,.webp,.gif,.mov,.mp4,.m4v,.webm" />
        </label>
      </div>
      <ol id="upload-progress" class="upload-progress" hidden></ol>
      <template id="upload-file-template">
        <li class="upload-file">
          <span class="upload-preview"></span>
          <span class="upload-body">
            <span class="upload-name"></span>
            <progress max="1" value="0"></progress>
            <span class="upload-note">Queued</span>
          </span>
        </li>
      </template>
    </div>

    <div class="day-nav">
      <button type="button" id="prev-day">Previous day</button>
      <label class="jump">
        Day
        <input type="date" id="jump-date" />
      </label>
      <button type="button" id="next-day">Next day</button>
      <button type="button" id="save-day" class="primary">Save day</button>
    </div>

    <p id="status" class="meta" aria-live="polite"></p>

    <div class="note-layout">
      <p class="note-tools">
        <button type="button" id="added-photos-toggle" aria-expanded="false">View uploaded media</button>
      </p>
      <div id="dropzone" class="dropzone">
        <textarea
          id="day-body"
          rows="18"
          placeholder="Write this day's notes. Drag a thumbnail from View uploaded media onto this text."
        ></textarea>
        <div class="drop-hint">Drag a photo or video from View uploaded media onto this note. A click does not add it. Photos are re-saved without location data. Video location data may remain. Notes are stored with the trip, not in git.</div>
      </div>
      <aside id="added-photos" hidden>
        <p id="pool-hint" class="meta">Click a thumbnail to select it. Drag across the grid to select several. Drag a thumbnail onto the note to place it.</p>
        <p id="pool-actions" hidden>
          <button type="button" id="pool-remove">Remove</button>
          <button type="button" id="pool-download">Download</button>
        </p>
        <div id="media-pool" class="cover-grid"></div>
        <button type="button" id="added-photos-close" class="linkish">Close</button>
      </aside>
    </div>

    <div class="upload-row">
      <label class="file-btn">
        Add GPX
        <input id="gpx-input" type="file" accept=".gpx,.zip" />
      </label>
    </div>
    <p class="publish-row">
      <button type="button" id="publish-trip" class="is-danger">Hide from the public site</button>
    </p>
  </div>
  <div id="photo-preview" hidden>
    <button type="button" id="photo-preview-close">Close</button>
    <div id="photo-preview-frame"></div>
  </div>
</section>

<style>
  .author,
  .editor {
    max-width: 48rem;
  }
  .author h1,
  .author h2,
  .editor h1 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }
  .editor h1 {
    margin: 0.4rem 0;
  }
  .author-form,
  .home-url {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0;
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .author-form label,
  .home-url,
  .jump {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }
  input,
  textarea {
    font: inherit;
    font-size: 16px;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line);
    background: #fff;
  }
  textarea {
    width: 100%;
    font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
    line-height: 1.5;
    padding: 0.9rem;
    resize: vertical;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .kind-choice {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.2rem;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }
  .kind-choice label {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.35rem;
    width: auto;
  }
  button,
  .file-btn {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    width: fit-content;
  }
  button.linkish {
    background: transparent;
    color: var(--muted);
    border-color: transparent;
    padding: 0;
    margin: 0.25rem 0 0;
  }
  .day-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: end;
    margin: 1.25rem 0 0.75rem;
  }
  .day-nav button,
  .file-btn {
    font-size: 0.9rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }
  .day-nav button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .day-nav button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .dropzone.dragover textarea {
    outline: 2px solid var(--accent);
  }
  .drop-hint {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.4rem;
  }
  .cover-picker {
    margin: 0.25rem 0 0.75rem;
  }
  .cover-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.2rem 0 0.45rem;
  }
  .cover-summary img {
    width: 3rem;
    height: 2.2rem;
    object-fit: cover;
    margin: 0;
  }
  #cover-toggle,
  #added-photos-toggle {
    font-size: 0.9rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }
  .note-tools {
    margin: 0;
  }
  .note-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  .editor:has(#added-photos:not([hidden])) {
    max-width: 72rem;
  }
  .note-layout:has(#added-photos:not([hidden])) {
    grid-template-columns: minmax(0, 1fr) 17.5rem;
  }
  .note-layout:has(#added-photos:not([hidden])) .note-tools {
    grid-column: 1 / -1;
  }
  #added-photos[hidden] {
    display: none;
  }
  #added-photos:not([hidden]) {
    display: flex;
    flex-direction: column;
    height: calc(18 * 1.5 * 16px + 1.8rem);
    max-height: calc(18 * 1.5 * 16px + 1.8rem);
    overflow: hidden;
  }
  #added-photos #media-pool {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    align-content: start;
  }
  .upload-count {
    margin: 0.2rem 0 0.6rem;
  }
  .file-drop {
    display: grid;
    gap: 0.55rem;
    justify-items: start;
    margin: 0.6rem 0;
    padding: 0.9rem;
    border: 1px dashed var(--line);
    background: var(--surface);
  }
  .file-drop.dragover {
    outline: 2px solid var(--accent);
  }
  .file-drop p {
    margin: 0;
  }
  .file-btn {
    position: relative;
  }
  .file-btn input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .cover-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: 0.6rem;
    margin: 0.4rem 0 0.6rem;
  }
  button.cover-choice {
    display: grid;
    gap: 0.3rem;
    width: 100%;
    padding: 0.35rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    text-align: left;
  }
  button.cover-choice.is-selected {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
  }
  .cover-choice img,
  .cover-choice video {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #e4ddd0;
    pointer-events: none;
  }
  .media-pool {
    margin: 0.25rem 0 0.75rem;
  }
  .cover-choice span {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.3;
    word-break: break-word;
  }
  #pool-actions {
    display: flex;
    gap: 0.45rem;
    margin: 0;
  }
  #pool-actions[hidden] {
    display: none !important;
  }
  #pool-marquee {
    position: fixed;
    z-index: 20;
    border: 1px solid #2e4a3e;
    background: rgba(46, 74, 62, 0.18);
    pointer-events: none;
  }
  #media-pool {
    display: grid;
    grid-template-columns: repeat(auto-fill, 7.5rem);
    gap: 0.45rem;
    position: relative;
  }
  button.pool-thumb {
    display: block;
    width: 7.5rem;
    height: 5.625rem;
    padding: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #e4ddd0;
  }
  button.pool-thumb.is-selected {
    outline: 3px solid #2e4a3e;
    outline-offset: -3px;
  }
  button.pool-thumb img,
  button.pool-thumb video {
    width: 7.5rem;
    height: 5.625rem;
    max-width: 7.5rem;
    max-height: 5.625rem;
    object-fit: cover;
    margin: 0;
    display: block;
    pointer-events: none;
  }
  .thumb-tip {
    position: fixed;
    z-index: 8;
    max-width: 16rem;
    padding: 0.25rem 0.45rem;
    background: #1c241e;
    color: #f3efe6;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.3;
    pointer-events: none;
  }
  .thumb-tip[hidden] {
    display: none;
  }
  .upload-progress {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0.75rem;
    display: grid;
    gap: 0.45rem;
  }
  .upload-file {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 0.55rem;
    align-items: center;
  }
  .upload-preview {
    width: 6rem;
    height: 4.5rem;
    overflow: hidden;
    background: #e4ddd0;
  }
  .upload-preview img,
  .upload-preview video {
    width: 6rem;
    height: 4.5rem;
    max-width: 6rem;
    max-height: 4.5rem;
    object-fit: cover;
    margin: 0;
    display: block;
  }
  .upload-body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .upload-name {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .upload-note {
    font-size: 0.75rem;
  }
  .upload-file[data-phase="failed"] .upload-note {
    color: #8a2f2f;
  }
  .upload-progress progress {
    width: 100%;
  }
  #save-cover {
    font-size: 0.9rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }
  #photo-preview {
    position: fixed;
    inset: 0;
    z-index: 6;
    display: grid;
    place-items: center;
    background: rgba(28, 36, 30, 0.9);
  }
  #photo-preview[hidden] {
    display: none;
  }
  #photo-preview img,
  #photo-preview video {
    max-width: min(92vw, 64rem);
    max-height: 86vh;
    margin: 0;
  }
  #photo-preview-close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    background: var(--surface);
    color: var(--ink);
    border: 0;
  }
  #publish-trip {
    margin-top: 2.5rem;
    font-size: 0.95rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }
  #publish-trip.is-danger {
    background: #8a2f2f;
    border-color: #8a2f2f;
    color: #fff;
  }
  .upload-row {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.9rem;
    flex-wrap: wrap;
  }
  .file-btn {
    display: inline-block;
  }
  .error {
    color: #8a2f2f;
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }
  .author-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .author-list a {
    font-family: var(--font-ui);
  }
  code {
    font-size: 0.85em;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { mountAuthor } from "../lib/github/author-ui";

  const root = document.querySelector<HTMLElement>("[data-author-root]");
  if (root) mountAuthor(root);
</script>
